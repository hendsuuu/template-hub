---
/**
 * One figure: a header strip (icon and label) over a box with corner brackets
 * holding the value, a mini chart and a meta line. Render inside a <dl>.
 * Slots: `chart`, `meta`, `corner`.
 */
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  icon: IconName;
  label: string;
  value: string | number;
  /** Quieter text after the value, e.g. "of 4". */
  suffix?: string;
  /** Orange value and marks, for a number that needs a person. */
  attention?: boolean;
}

const { icon, label, value, suffix, attention = false } = Astro.props;
const corner = Astro.slots.has("corner");
---

<div class:list={["ak-stat", attention && "ak-stat--attention", corner && "ak-stat--with-corner"]}>
  <dt class="ak-stat__head">
    <span class="ak-stat__icon" aria-hidden="true"><Icon name={icon} size={14} /></span>
    <span class="ak-stat__label">{label}</span>
  </dt>
  <dd class="ak-stat__body">
    {corner && <span class="ak-stat__corner"><slot name="corner" /></span>}
    <div class="ak-stat__inner ak-bracketed">
      <div class="ak-stat__row">
        <span class="ak-stat__value">{value}{suffix && <span class="ak-stat__suffix"> {suffix}</span>}</span>
        {Astro.slots.has("chart") && <span class="ak-stat__chart"><slot name="chart" /></span>}
      </div>
      {Astro.slots.has("meta") && <div class="ak-stat__meta"><slot name="meta" /></div>}
    </div>
  </dd>
</div>

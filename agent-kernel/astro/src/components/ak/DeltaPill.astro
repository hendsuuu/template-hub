---
import Icon from "./Icon.astro";
import Pill from "./Pill.astro";

interface Props {
  /** Whole percent change, or null when there is nothing to compare with. */
  change: number | null;
  /** What it is compared with, e.g. "the 7 days before". */
  against: string;
}

const { change, against } = Astro.props;
const words =
  change === null ? "" : change === 0 ? `No change on ${against}` : `${change > 0 ? "Up" : "Down"} ${Math.abs(change)}% on ${against}`;
---

{
  change !== null && (
    <Pill title={words}>
      {change !== 0 && <Icon name={change < 0 ? "chevron-down" : "chevron-up"} size={12} strokeWidth={2.5} />}
      <span aria-hidden="true">{change === 0 ? "0%" : `${Math.abs(change)}%`}</span>
      <span class="sr-only">{words}</span>
    </Pill>
  )
}

---
/** A search box with an icon and a clear button. With `target`, ui.js filters that table as you type. */
import Icon from "./Icon.astro";
import { idFrom } from "../../lib/ui";

interface Props {
  label: string;
  placeholder?: string;
  /** The table to filter, e.g. "#agents". */
  target?: string;
  class?: string;
}

const { label, placeholder = "Search", target, class: className } = Astro.props;
const id = idFrom(label, "search");
---

<div class:list={["ak-search", className]}>
  <label for={id} class="sr-only">{label}</label>
  <Icon name="search" size={15} class="ak-search__icon" />
  <input id={id} type="search" class="ak-search__input" placeholder={placeholder} autocomplete="off" spellcheck="false" data-ak-search={target} />
  <button type="button" class="ak-search__clear" aria-label="Clear the search" title="Clear the search"><Icon name="x" size={14} /></button>
</div>

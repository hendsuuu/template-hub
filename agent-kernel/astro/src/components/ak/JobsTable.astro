---
/** Jobs as a table: ui.js sorts it from the headers; the job and the whole row open the job. */
import type { JobListItem } from "../../lib/types";
import { formatAgo, formatDateTime, formatUsd } from "../../lib/format";
import { describeAssignee } from "../../lib/jobs";
import { paths } from "../../lib/paths";
import { JOB_STATUS_ORDER } from "../../lib/status";
import JobStatusTag from "./JobStatusTag.astro";
import SortButton from "./SortButton.astro";

interface Props {
  id: string;
  jobs: readonly JobListItem[];
  now: Date;
  caption: string;
  /** Fewer columns and denser rows, for the overview. */
  compact?: boolean;
}

const { id, jobs, now, caption, compact = false } = Astro.props;
---

<div class:list={["ak-table-wrap", compact ? "ak-table-wrap--cards-sm" : "ak-table-wrap--cards-md"]}>
  <table class:list={["ak-table", compact && "ak-table--compact"]} id={id} data-ak-sortable>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="ak-job-cell"><SortButton>Job</SortButton></th>
        <th scope="col"><SortButton>Agent</SortButton></th>
        <th scope="col"><SortButton>Status</SortButton></th>
        {!compact && <th scope="col" class="is-end"><SortButton>Attempts</SortButton></th>}
        <th scope="col" class="is-end"><SortButton>Spent</SortButton></th>
        <th scope="col"><SortButton>Updated</SortButton></th>
      </tr>
    </thead>
    <tbody>
      {
        jobs.map((job) => (
          <tr class="ak-row--clickable" data-href={paths.job(job.jobId)} data-search={`${job.jobId} ${job.objective}`.toLowerCase()} data-status={job.status}>
            <td class="ak-job-cell is-primary" data-sort-value={job.objective}>
              <a href={paths.job(job.jobId)} class="ak-job-link">
                <span class="ak-job-link__id">{job.jobId}</span>
                <span class="ak-job-link__objective">{job.objective}</span>
              </a>
            </td>
            <td data-label="Agent" data-sort-value={describeAssignee(job.heldBy ?? job.assignee)}>
              <span class="ak-wrap-anywhere">{describeAssignee(job.heldBy ?? job.assignee)}</span>
            </td>
            <td data-label="Status" data-sort-value={JOB_STATUS_ORDER.indexOf(job.status)}>
              <JobStatusTag status={job.status} />
            </td>
            {!compact && (
              <td class="is-end" data-label="Attempts" data-sort-value={job.attempts}>
                {job.attempts}
              </td>
            )}
            <td class="is-end" data-label="Spent" data-sort-value={job.spentUsd}>
              <span class="ak-nowrap">
                {formatUsd(job.spentUsd)}
                {!compact && job.limitUsd !== null && <span class="ak-limit">of {formatUsd(job.limitUsd)}</span>}
              </span>
            </td>
            <td data-label="Updated" data-sort-value={-new Date(job.updatedAt).getTime()}>
              <time datetime={job.updatedAt} title={formatDateTime(job.updatedAt)} class="ak-updated">
                {formatAgo(job.updatedAt, now)}
              </time>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

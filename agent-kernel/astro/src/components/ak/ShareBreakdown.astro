---
/** Each agent's share of the work: name, role, count and share, each row with one neutral meter. */
import type { AgentShare } from "../../lib/types";
import { shareRows } from "../../lib/share";
import { cssVars } from "../../lib/style";
import { paths } from "../../lib/paths";

interface Props {
  items: readonly AgentShare[];
  /** Each agent's role, for the sub-label. */
  roles: Readonly<Record<string, string>>;
}

const { items, roles } = Astro.props;
const rows = shareRows(items.map((item) => ({ key: item.agentId, count: item.jobs })));
const largest = Math.max(...rows.map((row) => row.percent), 1);
const percentText = (value: number) => (value === 0 ? "<1%" : `${value}%`);
---

{
  rows.length === 0 ? (
    <p class="ak-none">No agent started a job in the last 7 days.</p>
  ) : (
    <ul class="ak-shares">
      {rows.map((row) => {
        const Tag = row.other ? "div" : "a";
        return (
          <li>
            <Tag class:list={["ak-share", row.other && "ak-share--other"]} href={row.other ? undefined : paths.board(row.key)}>
              <span class="ak-share__name">{row.other ? `${row.key} agents` : row.key}</span>
              <span class="ak-share__sub">{row.other ? "combined" : (roles[row.key] ?? "")}</span>
              <span class="ak-share__count">{row.count === 1 ? "1 job" : `${row.count} jobs`}</span>
              <span class="ak-share__percent">{percentText(row.percent)}</span>
              <span class="ak-share__meter" aria-hidden="true">
                <span style={cssVars({ "--w": `${(row.percent / largest) * 100}%` })} />
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  )
}

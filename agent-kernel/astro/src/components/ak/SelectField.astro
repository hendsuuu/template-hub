---
/**
 * A native select in the template's control style; put <option>s in the slot.
 * With `filter` and `target`, ui.js shows only the rows whose data-<filter>
 * equals the chosen value (an empty value shows all).
 */
import { idFrom } from "../../lib/ui";

interface Props {
  label: string;
  showLabel?: boolean;
  filter?: string;
  target?: string;
  class?: string;
}

const { label, showLabel = false, filter, target, class: className } = Astro.props;
const id = idFrom(label, "select");
---

<div class:list={["ak-select-field", className]}>
  <label for={id} class={showLabel ? "ak-label" : "sr-only"}>{label}</label>
  <select id={id} class="ak-select" data-ak-filter={filter} data-ak-filter-target={target}><slot /></select>
</div>

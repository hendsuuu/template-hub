---
import type { AgentStatus } from "../../lib/types";
import { AGENT_STATUS } from "../../lib/status";
import StatusDot from "./StatusDot.astro";

interface Props {
  status: AgentStatus;
}

const { status } = Astro.props;
const info = AGENT_STATUS[status];
---

<span class:list={["ak-status", `ak-status--${info.tone}`]} title={info.meaning}>
  <StatusDot status={status} />
  {info.label}
  <span class="sr-only">. {info.meaning}</span>
</span>

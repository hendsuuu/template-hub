---
/** Page icon and title on the left; live state, last update, refresh, "Waiting for you" and the user on the right. */
import type { DashboardUser } from "../../lib/types";
import { formatClock, initials } from "../../lib/format";
import { pageFor } from "../../lib/nav";
import { paths } from "../../lib/paths";
import Icon from "./Icon.astro";
import IconButton from "./IconButton.astro";

interface Props {
  user: DashboardUser;
  updatedAt: Date;
  /** Jobs waiting for a person: the bell's count. */
  waiting: number;
  /** A title for pages outside the navigation, such as "Page not found". */
  title?: string;
}

const { user, updatedAt, waiting, title } = Astro.props;
const page = pageFor(Astro.url.pathname);
const waitingLabel = waiting === 0 ? "Waiting for you: nothing" : `Waiting for you: ${waiting} ${waiting === 1 ? "job" : "jobs"}`;
---

<header class="ak-topbar">
  <button type="button" class="ak-topbar__menu" popovertarget="ak-nav-drawer" aria-label="Open menu">
    <Icon name="menu" size={18} />
  </button>

  <div class="ak-topbar__title-row">
    <Icon name={page.icon} size={20} class="ak-topbar__page-icon" />
    <h1 tabindex="-1" class="ak-topbar__title">{title ?? page.label}</h1>
  </div>

  <div class="ak-topbar__tools">
    <p class="ak-live" title="Live updates are on." role="status">
      <span class="ak-live__dot" aria-hidden="true"></span>
      <span class="ak-live__label" aria-hidden="true">Live</span>
      <span class="sr-only">Live updates are on.</span>
    </p>
    <p class="ak-topbar__updated">
      <span class="ak-topbar__updated-word">Updated </span>
      <time datetime={updatedAt.toISOString()}>{formatClock(updatedAt)}</time>
    </p>
    {/* Wire this to your data refetch. */}
    <IconButton label="Refresh now" icon="refresh-cw" />
    <a href={paths.boardWaiting()} class:list={["ak-icon-btn", waiting > 0 && "ak-topbar__waiting"]} aria-label={waitingLabel} title={waitingLabel}>
      <Icon name="bell" />
      {waiting > 0 && <span class="ak-topbar__badge" aria-hidden="true">{waiting > 99 ? "99+" : waiting}</span>}
    </a>
    <span class="ak-avatar" role="img" aria-label={`Signed in as ${user.name}`} title={`${user.name} · ${user.email}`}>{initials(user.name)}</span>
  </div>
</header>

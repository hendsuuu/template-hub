---
/** Jobs finished per day as thin columns with a soft fade and a faint track behind each. */
import type { DailyActivity } from "../../lib/types";
import { formatDay } from "../../lib/format";
import { cssVars, percent } from "../../lib/style";

interface Props {
  days: readonly DailyActivity[];
  /** The most recent days drawn bright: the period the panel is about. */
  highlightLast: number;
}

const { days, highlightLast } = Astro.props;
const totals = days.map((d) => d.completed + d.failed);
const max = Math.max(1, ...totals);
const first = days[0];
const last = days[days.length - 1];
const period = days.slice(-highlightLast).reduce((sum, d) => sum + d.completed + d.failed, 0);
---

<figure>
  <div class="ak-histogram__plot" aria-hidden="true">
    {
      days.map((day, index) => (
        <span
          class:list={["ak-histogram__col", index < days.length - highlightLast && "ak-histogram__col--dim"]}
          title={`${formatDay(day.day)}: ${totals[index]} finished`}
        >
          <span class="ak-histogram__track">
            {(totals[index] ?? 0) > 0 && <span class="ak-histogram__bar" style={cssVars({ "--h": percent(totals[index] ?? 0, max) })} />}
          </span>
        </span>
      ))
    }
  </div>
  <figcaption class="ak-histogram__caption">
    <span>{first ? formatDay(first.day) : ""}</span>
    <span class="ak-histogram__legend">
      <span class="ak-histogram__swatch" aria-hidden="true"></span>
      Finished, last {highlightLast} days: {period}
    </span>
    <span>{last ? formatDay(last.day) : ""}</span>
  </figcaption>
</figure>

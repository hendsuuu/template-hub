---
import type { HTMLAttributes } from "astro/types";
import Icon, { type IconName } from "./Icon.astro";

type Props = Omit<HTMLAttributes<"button">, "children"> & {
  /** Says what it does; it is the button's only text. */
  label: string;
  icon: IconName;
  /** Renders a link instead of a button. */
  href?: string;
};

const { label, icon, href, class: className, ...rest } = Astro.props;
---

{
  href ? (
    <a href={href} class:list={["ak-icon-btn", className]} aria-label={label} title={label}>
      <Icon name={icon} />
    </a>
  ) : (
    <button type="button" class:list={["ak-icon-btn", className]} aria-label={label} title={label} {...rest}>
      <Icon name={icon} />
    </button>
  )
}

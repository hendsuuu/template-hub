---
import type { JobStatus } from "../../lib/types";
import { JOB_STATUS } from "../../lib/status";

interface Props {
  status: JobStatus;
}

const { status } = Astro.props;
const info = JOB_STATUS[status];
---

<span class:list={["ak-tag", `ak-tag--${info.tone}`]} title={info.meaning}>
  <span class="ak-tag__mark" aria-hidden="true"></span>
  {info.label}
</span>

---
/**
 * A titled section: a header row (title, subtitle, controls) over its content.
 * Slots: `subtitle` (instead of the prop), `actions`, `before` (before the header,
 * such as the radios a panel reads with :has()), and the default slot.
 */
interface Props {
  title: string;
  subtitle?: string;
  /** Content that runs edge to edge, such as a table. */
  flush?: boolean;
  /** Small controls that stay on the title row on phones. */
  inline?: boolean;
  class?: string;
  id?: string;
}

const { title, subtitle, flush = false, inline = false, class: className, id } = Astro.props;
const titleId = `${id ?? title.toLowerCase().replace(/[^a-z0-9]+/g, "-")}-title`;
const hasSubtitle = Boolean(subtitle) || Astro.slots.has("subtitle");
---

<section id={id} aria-labelledby={titleId} class:list={["ak-panel", inline && "ak-panel--inline", className]}>
  <slot name="before" />
  <header class="ak-panel__head">
    <div class="ak-panel__heading">
      <h2 id={titleId} class="ak-panel__title">{title}</h2>
      {hasSubtitle && <p class="ak-panel__subtitle"><slot name="subtitle">{subtitle}</slot></p>}
    </div>
    {Astro.slots.has("actions") && <div class="ak-panel__actions"><slot name="actions" /></div>}
  </header>
  <div class={flush ? "ak-panel__flush" : "ak-panel__body"}><slot /></div>
</section>

---
/**
 * Two or three options, exactly one on (e.g. Jobs / Spend). Native radios, so
 * it needs no script: CSS shows the parts of the panel that belong to the
 * checked one (see `.ak-activity` in the stylesheet).
 */
interface Props {
  label: string;
  name: string;
  options: ReadonlyArray<{ value: string; label: string }>;
  defaultValue: string;
}

const { label, name, options, defaultValue } = Astro.props;
---

<div role="radiogroup" aria-label={label} class="ak-segmented">
  {
    options.map((option) => (
      <span class="contents">
        <input
          type="radio"
          class="sr-only"
          id={`${name}-${option.value}`}
          name={name}
          value={option.value}
          checked={option.value === defaultValue}
          data-ak-mode-input={option.value}
        />
        <label for={`${name}-${option.value}`} class="ak-segmented__option">
          {option.label}
        </label>
      </span>
    ))
  }
</div>

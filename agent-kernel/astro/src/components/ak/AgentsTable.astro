---
/**
 * Agents as a table: ui.js sorts it from the headers, filters it from any
 * search box or select that targets its id, and opens the agent's board from
 * a row. Sorted by status to start, as in the React version.
 */
import type { AgentSummary } from "../../lib/types";
import { formatAgo, formatDateTime, formatElapsed } from "../../lib/format";
import { paths } from "../../lib/paths";
import { agentStatusRank } from "../../lib/status";
import AgentAvatar from "./AgentAvatar.astro";
import SortButton from "./SortButton.astro";
import StatusBadge from "./StatusBadge.astro";

interface Props {
  id: string;
  agents: readonly AgentSummary[];
  now: Date;
  caption: string;
}

const { id, agents, now, caption } = Astro.props;
// Stable, so agents with the same status keep their order, as the React table does.
const sorted = [...agents].sort((a, b) => agentStatusRank(a.status) - agentStatusRank(b.status));
const seen = (a: AgentSummary) => (a.lastSeenAt ? String(-new Date(a.lastSeenAt).getTime()) : "");
---

<div class="ak-table-wrap ak-table-wrap--cards-md">
  <table class="ak-table" id={id} data-ak-sortable>
    <caption class="sr-only">{caption}</caption>
    <thead>
      <tr>
        <th scope="col" class="ak-table__position"><span aria-hidden="true">#</span><span class="sr-only">Position</span></th>
        <th scope="col"><SortButton>Agent</SortButton></th>
        <th scope="col" aria-sort="ascending"><SortButton>Status</SortButton></th>
        <th scope="col" class="ak-work-cell">Current work</th>
        <th scope="col"><SortButton>Last seen</SortButton></th>
        <th scope="col"><SortButton>Last 24 h</SortButton></th>
        <th scope="col" class="is-end"><SortButton>Queued</SortButton></th>
      </tr>
    </thead>
    <tbody>
      {
        sorted.map((a, index) => (
          <tr class="ak-row--clickable" data-href={paths.board(a.agentId)} data-search={`${a.agentId} ${a.role}`.toLowerCase()} data-status={a.status}>
            <td class="ak-table__position is-wide-only" data-label="Position" data-ak-position>
              {index + 1}
            </td>
            <td class="is-primary" data-sort-value={a.agentId}>
              <div class="ak-who">
                <AgentAvatar />
                <div class="ak-identity">
                  <a href={paths.board(a.agentId)} class="ak-agent-name">
                    {a.agentId}
                  </a>
                  <span class="ak-role">{a.role}</span>
                </div>
              </div>
            </td>
            <td data-label="Status" data-sort-value={agentStatusRank(a.status)}>
              <StatusBadge status={a.status} />
            </td>
            <td class="ak-work-cell" data-label="Current work">
              {a.status === "working" && a.currentJob ? (
                <div class="ak-work">
                  <a href={paths.job(a.currentJob.jobId)} class="ak-job-id">
                    {a.currentJob.jobId}
                  </a>
                  <span class="ak-truncate">
                    {a.currentJob.objective}
                    {a.currentJob.since && <span class="ak-muted"> · {formatElapsed(a.currentJob.since, now)}</span>}
                  </span>
                </div>
              ) : a.status === "waiting" ? (
                <div class="ak-work">
                  <span class="ak-needs">Needs a person{a.waitingCount > 1 ? ` · ${a.waitingCount} jobs` : ""}</span>
                  <span class="ak-truncate">{a.waitingJob ? (a.waitingJob.reason ?? a.waitingJob.objective) : "A job is waiting for a person."}</span>
                </div>
              ) : (
                <span class="ak-muted">
                  {a.status === "working"
                    ? "Working on a job"
                    : a.status === "picking_up"
                      ? a.queuedFor > 1
                        ? `${a.queuedFor} jobs queued for it`
                        : "A job is queued for it"
                      : a.status === "idle"
                        ? "Nothing to do"
                        : a.status === "never"
                          ? `Registered ${formatAgo(a.registeredAt, now)}`
                          : a.status === "paused"
                            ? "Paused by an operator"
                            : "No recent check-in"}
                </span>
              )}
            </td>
            <td data-label="Last seen" data-sort-value={seen(a)}>
              {a.lastSeenAt ? (
                <time datetime={a.lastSeenAt} title={formatDateTime(a.lastSeenAt)} class="ak-muted ak-nowrap">
                  {formatAgo(a.lastSeenAt, now)}
                </time>
              ) : (
                <span class="ak-muted">Never</span>
              )}
            </td>
            <td data-label="Last 24 h" data-sort-value={a.completed24h}>
              <span class="ak-nowrap">
                {a.completed24h} done<span aria-hidden="true"> · </span>
                <span class="sr-only">, </span>
                <span class:list={[a.failed24h > 0 && "ak-failed-text"]}>{a.failed24h} failed</span>
              </span>
            </td>
            <td class="is-end" data-label="Queued" data-sort-value={a.queuedFor}>
              {a.queuedFor}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

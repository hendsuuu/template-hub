---
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  icon: IconName;
  title: string;
  text?: string;
  /** Inside a panel: no frame of its own. */
  bare?: boolean;
  /** Shown by ui.js when a filter leaves this table with no rows, e.g. "#agents". */
  emptyFor?: string;
}

const { icon, title, text, bare = false, emptyFor } = Astro.props;
---

<div class:list={["ak-empty", bare && "ak-empty--bare"]} data-ak-empty-for={emptyFor} hidden={emptyFor ? true : undefined}>
  <span class="ak-empty__icon" aria-hidden="true"><Icon name={icon} size={18} /></span>
  <p class="ak-empty__title">{title}</p>
  {text && <p class="ak-empty__text">{text}</p>}
  <slot />
</div>

---
/** A row of toggle buttons; exactly one is pressed. With `filter` and `target`, ui.js filters that table. */
import type { Chip } from "../../lib/ui";

interface Props {
  label: string;
  chips: readonly Chip[];
  selected: string;
  filter?: string;
  target?: string;
}

const { label, chips, selected, filter, target } = Astro.props;
---

<div role="group" aria-label={label} class="ak-chips" data-ak-filter={filter} data-ak-filter-target={target}>
  {
    chips.map((chip) => (
      <button type="button" class="ak-chip" aria-pressed={String(chip.value === selected)} data-value={chip.value === "all" ? "" : chip.value}>
        {chip.label}
        <span class="ak-chip__count">{chip.count}</span>
      </button>
    ))
  }
</div>

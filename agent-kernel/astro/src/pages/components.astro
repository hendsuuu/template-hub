---
/** Every Astro component of the template in one place, with the classes it is built from. */
import AppLayout from "../layouts/AppLayout.astro";
import ActivityChart from "../components/ak/ActivityChart.astro";
import AgentsTable from "../components/ak/AgentsTable.astro";
import Banner from "../components/ak/Banner.astro";
import Button from "../components/ak/Button.astro";
import DeltaPill from "../components/ak/DeltaPill.astro";
import EmptyState from "../components/ak/EmptyState.astro";
import FilterChips from "../components/ak/FilterChips.astro";
import Icon from "../components/ak/Icon.astro";
import IconButton from "../components/ak/IconButton.astro";
import JobStatusTag from "../components/ak/JobStatusTag.astro";
import MiniBars from "../components/ak/MiniBars.astro";
import PageHeader from "../components/ak/PageHeader.astro";
import Panel from "../components/ak/Panel.astro";
import PeriodChip from "../components/ak/PeriodChip.astro";
import Pill from "../components/ak/Pill.astro";
import SearchField from "../components/ak/SearchField.astro";
import Segmented from "../components/ak/Segmented.astro";
import SelectField from "../components/ak/SelectField.astro";
import StatCard from "../components/ak/StatCard.astro";
import StatusBadge from "../components/ak/StatusBadge.astro";
import StatusDot from "../components/ak/StatusDot.astro";
import Switch from "../components/ak/Switch.astro";
import { NOW, getAgents, getHub } from "../lib/data";
import { AGENT_STATUSES, JOB_STATUSES } from "../lib/types";
import type { MiniBar } from "../lib/ui";

const bars = [4, 7, 5, 9, 6, 3, 8];
const tone = (t: MiniBar["tone"]) => bars.map((value) => ({ value, tone: t }));
const rows = "flex flex-wrap items-center gap-3 border-b border-line py-3 last:border-b-0";
const label = "ak-small w-40 shrink-0";
---

<AppLayout title="Components">
  <div class="ak-page">
    <PageHeader title="Components" subtitle="Every building block of the template, with the classes it uses. The same classes work in the React, Next.js and Laravel starters.">
      <PeriodChip slot="aside">ak-* classes</PeriodChip>
    </PageHeader>

    <Panel title="Buttons" id="buttons">
      <code slot="subtitle" class="ak-cron">ak-btn · ak-btn--primary | --secondary | --quiet | --danger · ak-btn--sm · ak-icon-btn</code>
      <div class={rows}>
        <p class={label}>Variants</p>
        <div class="flex flex-wrap items-center gap-2">
          <Button><Icon name="plus" size={15} />New job</Button>
          <Button variant="secondary"><Icon name="download" size={15} />Export</Button>
          <Button variant="quiet">Clear</Button>
          <Button variant="danger"><Icon name="ban" size={15} />Cancel job</Button>
        </div>
      </div>
      <div class={rows}>
        <p class={label}>Small</p>
        <div class="flex flex-wrap items-center gap-2">
          <Button size="sm">Run now</Button>
          <Button variant="secondary" size="sm"><Icon name="play" size={13} />Run now</Button>
          <Button variant="quiet" size="sm">Show every agent</Button>
          <Button size="sm" disabled>Disabled</Button>
        </div>
      </div>
      <div class={rows}>
        <p class={label}>Icon buttons</p>
        <div class="flex flex-wrap items-center gap-2">
          <IconButton label="Refresh" icon="refresh-cw" />
          <IconButton label="Settings" icon="settings" />
          <IconButton label="Disabled" icon="bot" disabled />
        </div>
      </div>
    </Panel>

    <div class="grid grid-cols-2 gap-3 @max-[880px]:grid-cols-1">
      <Panel title="Pills and changes" id="pills">
        <code slot="subtitle" class="ak-cron">ak-pill · ak-pill--neutral | --blue | --green | --orange | --red | --grey</code>
        <div class={rows}>
          <p class={label}>Tones</p>
          <div class="flex flex-wrap items-center gap-2">
            <Pill>3 not online</Pill><Pill tone="blue">2 queued</Pill><Pill tone="green">All clear</Pill><Pill tone="orange">Needs you</Pill><Pill tone="red">error</Pill><Pill tone="grey">Paused</Pill>
          </div>
        </div>
        <div class={rows}>
          <p class={label}>Change</p>
          <div class="flex flex-wrap items-center gap-2">
            <DeltaPill change={14} against="the 7 days before" /><DeltaPill change={-6} against="the 7 days before" /><DeltaPill change={0} against="the 7 days before" />
          </div>
        </div>
        <div class={rows}>
          <p class={label}>Dots</p>
          <div class="flex flex-wrap items-center gap-2">{AGENT_STATUSES.map((status) => <StatusDot status={status} />)}</div>
        </div>
      </Panel>
      <Panel title="Statuses" id="statuses">
        <code slot="subtitle" class="ak-cron">ak-status · ak-dot--&lt;status&gt; · ak-tag · ak-tag--&lt;tone&gt;</code>
        <div class={rows}>
          <p class={label}>Agents</p>
          <div class="flex flex-wrap items-center gap-2">{AGENT_STATUSES.map((status) => <StatusBadge status={status} />)}</div>
        </div>
        <div class={rows}>
          <p class={label}>Jobs</p>
          <div class="flex flex-wrap items-center gap-2">{JOB_STATUSES.map((status) => <JobStatusTag status={status} />)}</div>
        </div>
      </Panel>
    </div>

    <Panel title="Fields" id="fields">
      <code slot="subtitle" class="ak-cron">ak-search · ak-select · ak-segmented · ak-switch · ak-chips · ak-chip</code>
      <div class={rows}>
        <p class={label}>Search and select</p>
        <div class="flex flex-wrap items-center gap-2">
          <SearchField label="Search the sample" />
          <SelectField label="Status"><option value="">Any status</option><option value="working">Working</option><option value="waiting">Waiting for you</option></SelectField>
        </div>
      </div>
      <div class={rows}>
        <p class={label}>Segmented</p>
        <Segmented label="Show" name="ak-demo-mode" defaultValue="jobs" options={[{ value: "jobs", label: "Jobs" }, { value: "spend", label: "Spend" }]} />
      </div>
      <div class={rows}>
        <p class={label}>Switch</p>
        <Switch checked label="Run on its schedule" />
      </div>
      <div class={rows}>
        <p class={label}>Filter chips</p>
        <FilterChips
          label="Show agents by status"
          selected="all"
          filter="status"
          target="#sample-agents"
          chips={[
            { value: "all", label: "All", count: 4 },
            { value: "working", label: "Working", count: 2 },
            { value: "picking_up", label: "Picking up", count: 1 },
            { value: "waiting", label: "Waiting for you", count: 1 },
          ]}
        />
      </div>
    </Panel>

    <section aria-label="Stat cards">
      <dl class="grid grid-cols-4 gap-3 @max-[880px]:grid-cols-2 @max-[520px]:grid-cols-1">
        <StatCard icon="bot" label="Agents online" value={5} suffix="of 8">
          <MiniBars slot="chart" bars={bars.map((value, i) => ({ value, tone: i < 5 ? "blue" : "grey" }))} history={false} />
          <Pill slot="meta">3 not online</Pill>
        </StatCard>
        <StatCard icon="hand" label="Waiting for you" value={3} attention>
          <MiniBars slot="chart" bars={tone("orange")} />
          <Pill slot="meta" tone="orange">Needs you</Pill>
        </StatCard>
        <StatCard icon="wallet" label="Spend (7 days)" value="$6.78">
          <DeltaPill slot="corner" change={14} against="the 7 days before" />
          <MiniBars slot="chart" bars={tone("blue")} />
          <span slot="meta">ak-stat · ak-stat--attention · ak-minibars</span>
        </StatCard>
        <StatCard icon="bot" label="Empty" value={0}>
          <MiniBars slot="chart" bars={bars.map(() => ({ value: 0, tone: "green" }))} />
          <Pill slot="meta" tone="green">All clear</Pill>
        </StatCard>
      </dl>
    </section>

    <Panel title="Activity chart" class="ak-activity" id="chart">
      <code slot="subtitle" class="ak-cron">ak-activity · ak-chart · ak-chart__day · ak-chart__tooltip</code>
      <Segmented slot="actions" label="Show" name="ak-chart-mode" defaultValue="jobs" options={[{ value: "jobs", label: "Jobs" }, { value: "spend", label: "Spend" }]} />
      <ActivityChart days={getHub().activity} mode="jobs" />
      <ActivityChart days={getHub().activity} mode="spend" />
    </Panel>

    <Panel title="Data table" flush id="table">
      <code slot="subtitle" class="ak-cron">ak-table-wrap · ak-table-wrap--cards-sm | md | lg · ak-table · ak-sort · data-ak-sortable</code>
      <AgentsTable id="sample-agents" agents={getAgents().slice(0, 4)} now={NOW} caption="A sample of agents" />
      <EmptyState bare icon="search-x" title="No agents match" text="Try another status." emptyFor="#sample-agents" />
    </Panel>

    <Panel title="Feedback" id="feedback">
      <code slot="subtitle" class="ak-cron">ak-empty · ak-banner · ak-dialog</code>
      <div class="flex flex-col gap-4">
        <EmptyState icon="search-x" title="No agents match" text="Try another status or search.">
          <Button variant="secondary" size="sm">Show all agents</Button>
        </EmptyState>
        <Banner>The hub did not answer. Retrying in 10 seconds.<Button slot="action" variant="secondary" size="sm">Try again</Button></Banner>
        <div class="flex flex-wrap items-center gap-3">
          <Button variant="secondary" data-ak-dialog-open="#confirm-cancel">Open a confirmation</Button>
          <p class="ak-done" id="confirm-notice" aria-live="polite"></p>
        </div>
      </div>
      <dialog id="confirm-cancel" class="ak-dialog" aria-labelledby="confirm-cancel-title">
        <div class="ak-dialog__body">
          <h2 id="confirm-cancel-title" class="ak-dialog__title">Cancel this job?</h2>
          <p class="ak-dialog__text">The agent stops at its next heartbeat.</p>
          <div class="ak-dialog__actions">
            <Button variant="secondary" data-ak-dialog-close>Go back</Button>
            <Button variant="danger" data-ak-dialog-close data-ak-notice="The job was cancelled." data-ak-notice-target="#confirm-notice">Cancel job</Button>
          </div>
        </div>
      </dialog>
    </Panel>
  </div>
</AppLayout>
